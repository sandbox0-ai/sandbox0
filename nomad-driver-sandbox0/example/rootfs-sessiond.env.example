SANDBOX0_ROOTFS_NBD_DEVICES=/dev/nbd0,/dev/nbd1,/dev/nbd2,/dev/nbd3
SANDBOX0_ROOTFS_MAX_DIRTY_TAIL_BYTES=10737418240
SANDBOX0_ROOTFS_OBJECT_BUCKET=sandbox0-rootfs
SANDBOX0_ROOTFS_OBJECT_REGION=us-east-1
SANDBOX0_ROOTFS_OBJECT_ENDPOINT=https://s3.example.invalid
SANDBOX0_ROOTFS_OBJECT_ACCESS_KEY=replace-me
SANDBOX0_ROOTFS_OBJECT_SECRET_KEY=replace-me
SANDBOX0_ROOTFS_AUTHORITY_URL=https://regional-gateway.example.invalid
SANDBOX0_ROOTFS_AUTHORITY_CA=/etc/sandbox0/authority-ca.pem
SANDBOX0_ROOTFS_AUTHORITY_CERT=/etc/sandbox0/node.pem
SANDBOX0_ROOTFS_AUTHORITY_KEY=/etc/sandbox0/node-key.pem
SANDBOX0_ROOTFS_AUTHORITY_TOKEN=/run/secrets/sandbox0/writer-authority.token
SANDBOX0_NOMAD_ADDRESS=https://127.0.0.1:4646
SANDBOX0_NOMAD_NODE_ID=00000000-0000-0000-0000-000000000000
SANDBOX0_NOMAD_TOKEN_FILE=/run/secrets/sandbox0/nomad.token
SANDBOX0_NOMAD_CA=/etc/nomad.d/tls/nomad-agent-ca.pem
SANDBOX0_NOMAD_CERT=/etc/nomad.d/tls/global-client-nomad.pem
SANDBOX0_NOMAD_KEY=/etc/nomad.d/tls/global-client-nomad-key.pem
