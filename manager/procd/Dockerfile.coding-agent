# Build ZCode from a reviewed upstream commit because its CLI package is
# private and has no published npm artifact.
FROM node:24.14.0-bookworm AS zcode-build
ARG ZCODE_COMMIT=328c1a0c0ffaa5a4f65e8fa199af5e4c20706e5f
RUN apt-get update && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src/zcode
RUN git clone --filter=blob:none https://github.com/zai-org/ZCode.git . \
  && git checkout --detach "$ZCODE_COMMIT" \
  && test "$(git rev-parse HEAD)" = "$ZCODE_COMMIT" \
  && corepack enable \
  && corepack prepare pnpm@10.33.2 --activate
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @zcode/cli... build
# The monorepo has patches for desktop-only packages. Deployment includes only
# CLI dependencies, so permit those unrelated patches to be unused here.
RUN printf '\nallowUnusedPatches: true\n' >> pnpm-workspace.yaml \
  && pnpm deploy --legacy --filter @zcode/cli --prod /opt/zcode

# The Kimi npm CLI is a single bundle and does not expose its native SDK.
# Build the upstream SDK and loop exports from the matching reviewed release.
FROM node:24.21.0-bookworm AS kimi-sdk-build
ARG KIMI_COMMIT=21406fb4c805cc8c715e6d1f16ad3fb5f25f4fe3
RUN apt-get update && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src/kimi
RUN git clone --filter=blob:none https://github.com/MoonshotAI/kimi-code.git . \
  && git checkout --detach "$KIMI_COMMIT" \
  && test "$(git rev-parse HEAD)" = "$KIMI_COMMIT" \
  && corepack enable \
  && corepack prepare pnpm@10.33.0 --activate
COPY manager/procd/coding-agents/build-kimi-sdk.mjs ./build-kimi-sdk.mjs
RUN pnpm install --frozen-lockfile --ignore-scripts \
  && node build-kimi-sdk.mjs \
  && cp LICENSE sdk-host/dist/LICENSE

# Sandbox0 coding-agent template.
# This image intentionally does NOT define an ENTRYPOINT/CMD. The platform
# injects and starts procd, then Session Supervisor owns each coding agent.

FROM sandbox0ai/otemplates:default-v0.2.0

# Keep Docker startup compatible even when the pinned base predates this helper.
COPY --chmod=0755 manager/procd/sandbox0-dockerd-entrypoint /usr/local/bin/sandbox0-dockerd-entrypoint

# Docker BuildKit supplies TARGETARCH for the selected output platform. Do not
# give it a default: that would override BuildKit during native arm64 builds.
ARG TARGETARCH
ARG TTYD_VERSION=1.7.7
ARG NOVNC_VERSION=1.5.0
ARG NOVNC_SHA256=6a73e41f98388a5348b7902f54b02d177cb73b7e5eb0a7a0dcf688cc2c79b42a

# The headed browser is shared by VNC viewers and local CDP automation.
# It starts on demand; no browser process is part of a warm carrier.
ENV DEBIAN_FRONTEND=noninteractive \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    DISABLE_AUTOUPDATER=1 \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    PLAYWRIGHT_MCP_BROWSER=chromium \
    PLAYWRIGHT_MCP_ISOLATED=false \
    PLAYWRIGHT_MCP_SANDBOX=false \
    SANDBOX0_BROWSER_USER=sandbox-browser

# The native SDKs require Node.js 24.15+. Keep the pinned agents on the same
# supported runtime and fail if the distribution resolves an older release.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg openbox tigervnc-standalone-server tint2 feh wmctrl \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 24 || (major === 24 && minor < 15)) process.exit(1)' \
  && useradd --create-home --home-dir /home/sandbox-browser --shell /bin/bash "$SANDBOX0_BROWSER_USER" \
  && rm -rf /var/lib/apt/lists/*

# ttyd is included as an explicitly launched diagnostic/compatibility surface.
# procd sessions remain the durable terminal authority for agent platforms.
RUN case "${TARGETARCH}" in \
      amd64) ttyd_asset=x86_64; ttyd_sha=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55 ;; \
      arm64) ttyd_asset=aarch64; ttyd_sha=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165 ;; \
      *) echo "Unsupported ttyd architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
  && curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${ttyd_asset}" -o /usr/local/bin/ttyd \
  && echo "${ttyd_sha}  /usr/local/bin/ttyd" | sha256sum -c - \
  && chmod 0755 /usr/local/bin/ttyd \
  && ttyd --version

WORKDIR /opt/coding-agents

COPY manager/procd/coding-agents/package.json manager/procd/coding-agents/package-lock.json ./
COPY manager/procd/coding-agents/THIRD_PARTY.md ./
COPY manager/procd/coding-agents/inventory.mjs ./
COPY manager/procd/coding-agents/install-chrome-stable.sh ./
COPY --from=zcode-build /opt/zcode /opt/zcode
COPY --from=kimi-sdk-build /src/kimi/sdk-host/dist /opt/kimi-sdk

RUN npm ci --omit=dev \
  && for agent in codex claude opencode pi kimi playwright-cli; do ln -sf "/opt/coding-agents/node_modules/.bin/$agent" "/usr/local/bin/$agent"; done \
  && ln -sf /opt/zcode/dist/zcode.cjs /usr/local/bin/zcode \
  && bash install-chrome-stable.sh \
  && test -f /opt/coding-agents/node_modules/playwright-core/lib/tools/skills/playwright-cli/SKILL.md \
  && codex --version \
  && claude --version \
  && opencode --version \
  && pi --version \
  && kimi --version \
  && node --input-type=module -e 'import { cliVersion } from "/opt/kimi-sdk/index.mjs"; import { createRequire } from "node:module"; const require = createRequire(import.meta.url); if (require("@moonshot-ai/kimi-code/package.json").version !== cliVersion) throw new Error("Kimi CLI/SDK version mismatch")' \
  && zcode --version \
  && playwright-cli --version \
  && node inventory.mjs > harness-inventory.json \
  && npm cache clean --force

RUN mkdir -p /workspace

# Browser runtime and viewer are shared by standalone clients and applications.
# noVNC is installed once at build time, with its upstream license files retained.
COPY manager/procd/shared-browser/ /opt/sandbox0-browser/
COPY --chmod=0755 manager/procd/shared-browser/sandbox0-browser /usr/local/bin/sandbox0-browser
RUN curl -fsSL "https://codeload.github.com/novnc/noVNC/tar.gz/refs/tags/v${NOVNC_VERSION}" -o /tmp/novnc.tar.gz \
  && echo "${NOVNC_SHA256}  /tmp/novnc.tar.gz" | sha256sum -c - \
  && mkdir -p /opt/sandbox0-browser/novnc \
  && tar -xzf /tmp/novnc.tar.gz --strip-components=1 -C /opt/sandbox0-browser/novnc \
  && rm /tmp/novnc.tar.gz \
  && test -f /opt/sandbox0-browser/novnc/core/rfb.js \
  && test -f /opt/sandbox0-browser/novnc/LICENSE.txt \
  && node --check /opt/sandbox0-browser/browser.cjs \
  && NODE_PATH=/opt/coding-agents/node_modules node --test /opt/sandbox0-browser/browser.test.cjs \
  && sandbox0-browser --help

ENV HOME=/workspace

WORKDIR /workspace

# Intentionally no ENTRYPOINT/CMD here.
