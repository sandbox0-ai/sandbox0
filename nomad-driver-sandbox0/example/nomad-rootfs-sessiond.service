[Unit]
Description=Sandbox0 Nomad RootFS session owner
After=network-online.target systemd-modules-load.service
Wants=network-online.target
Before=nomad.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/sandbox0/rootfs-sessiond.env
ExecStart=/usr/local/bin/nomad-rootfs-sessiond \
  --socket=/run/sandbox0/rootfs-sessiond.sock \
  --runsc=/usr/local/bin/runsc \
  --runsc-root=/run/sandbox0/runsc \
  --state=/var/lib/sandbox0/rootfs-sessions.db \
  --branch-root=/var/lib/sandbox0/rootfs-branches \
  --max-dirty-tail-bytes=${SANDBOX0_ROOTFS_MAX_DIRTY_TAIL_BYTES} \
  --mount-root=/run/sandbox0/rootfs \
  --consumer-mount-root=/opt/nomad \
  --nbd-devices=${SANDBOX0_ROOTFS_NBD_DEVICES} \
  --object-bucket=${SANDBOX0_ROOTFS_OBJECT_BUCKET} \
  --object-region=${SANDBOX0_ROOTFS_OBJECT_REGION} \
  --object-endpoint=${SANDBOX0_ROOTFS_OBJECT_ENDPOINT} \
  --authority-url=${SANDBOX0_ROOTFS_AUTHORITY_URL} \
  --authority-ca=${SANDBOX0_ROOTFS_AUTHORITY_CA} \
  --authority-cert=${SANDBOX0_ROOTFS_AUTHORITY_CERT} \
  --authority-key=${SANDBOX0_ROOTFS_AUTHORITY_KEY} \
  --authority-token=${SANDBOX0_ROOTFS_AUTHORITY_TOKEN} \
  --nomad-address=${SANDBOX0_NOMAD_ADDRESS} \
  --nomad-node-id=${SANDBOX0_NOMAD_NODE_ID} \
  --nomad-token-file=${SANDBOX0_NOMAD_TOKEN_FILE} \
  --nomad-ca=${SANDBOX0_NOMAD_CA} \
  --nomad-cert=${SANDBOX0_NOMAD_CERT} \
  --nomad-key=${SANDBOX0_NOMAD_KEY}
Restart=always
RestartSec=1s
TimeoutStopSec=30s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
