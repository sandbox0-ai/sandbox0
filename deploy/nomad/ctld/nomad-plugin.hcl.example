plugin "sandbox0-gvisor" {
  config {
    runsc_path                    = "/usr/local/bin/runsc"
    runsc_root                    = "/run/sandbox0/runsc"
    runsc_operation_timeout_seconds = 30
    control_dir                   = "/run/sandbox0/nomad-slots"
    platform                      = "systrap"
    overlay2                      = "none"
    file_access                   = "shared"
    directfs                      = true
    resource_cgroup_root          = "/sys/fs/cgroup/sandbox0"
    rootfs_node_socket            = "/run/sandbox0/ctld-nomad-runtime.sock"
    rootfs_authority_url          = "https://replace-with-regional-authority:9443"
    rootfs_authority_ca_file      = "/etc/sandbox0/pki/manager-ca.pem"
    rootfs_authority_client_cert_file = "/etc/sandbox0/pki/ctld.pem"
    rootfs_authority_client_key_file  = "/etc/sandbox0/pki/ctld-key.pem"
    rootfs_authority_token_file       = "/etc/sandbox0/tokens/manager.token"
    procd_internal_jwt_public_key_file = "/etc/sandbox0/internal-auth/data-public.pem"
    runtime_slot_cluster_id           = "replace-with-cluster-id"
    runtime_slot_node_boot_id_file    = "/proc/sys/kernel/random/boot_id"
  }
}
